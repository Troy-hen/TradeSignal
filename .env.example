# Supabase — see README "Supabase setup"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Cloudflare Worker variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — transactional/platform email. Keep sender unset until the domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MyTradeBox
RESEND_REPLY_TO=

# AI enrichment + Ask MyTradeBox / RAG / Deep Research.
AI_ENRICHMENT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASK_MYTRADEBOX_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Planning data.
PLANNING_PROVIDER=mock
PLOTA_API_KEY=
PLOTA_MAX_PAGES_PER_RUN=1

# Published planning-contact enrichment. Enable only on a Plota key/plan with Contact Data.
# Homeowner private email/mobile enrichment is intentionally not supported.
CONTACT_INTELLIGENCE_PROVIDER=none
# CONTACT_INTELLIGENCE_PROVIDER=plota

# Property / recency intelligence. Enable when TwentyCI credentials are available.
# This is property-level context only; it does not provide permission to contact a homeowner electronically.
PROPERTY_INTELLIGENCE_PROVIDER=none
# PROPERTY_INTELLIGENCE_PROVIDER=twentyci
TWENTYCI_CLIENT_ID=
TWENTYCI_CLIENT_SECRET=
TWENTYCI_USERNAME=
TWENTYCI_PASSWORD=

# MHCLG Energy Performance of Buildings API (England and Wales).
# Create/sign in with GOV.UK One Login on the Energy Performance data service and copy the bearer token.
# EPC is used only on unlocked opportunities and cached; it does not create electronic marketing permission.
EPC_API_BEARER_TOKEN=

# Companies House public company intelligence. API key is free but requires a developer application.
COMPANIES_HOUSE_API_KEY=

# Physical postal outreach. Controls appear only when both values are configured.
POSTAL_OUTREACH_PROVIDER=none
# POSTAL_OUTREACH_PROVIDER=stannp
STANNP_API_KEY=

# Stable HMAC key used to make retry-safe public QuoteLinks for outbound messages.
# Generate a high-entropy secret and keep it server-side only.
QUOTE_LINK_SIGNING_SECRET=

# Public/commercial market-signal sources — Supabase Edge Function environment only.
# Comma-separated values supported: find-a-tender,contracts-finder,sell2wales,public-contracts-scotland
# Leave unset to default to find-a-tender + contracts-finder, or set to none to disable.
MARKET_SIGNAL_PROVIDERS=find-a-tender,contracts-finder

# Verifies pg_cron -> Supabase Edge Function calls.
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public legal/contact configuration.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=MyTradeBox
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=

# Demo-only territory activation.
MYTRADEBOX_DEMO_USER_EMAILS=
MYTRADEBOX_DEMO_USER_IDS=
