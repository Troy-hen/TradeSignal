# Supabase — see README "Supabase setup"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — see README "Stripe configuration". Never expose the secret key or
# webhook secret to the browser. Checkout is a pure server-side redirect to a
# hosted Checkout Session (no Stripe.js/Elements), so NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# isn't read by any code yet — kept here for convention/future client-side use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — see README "Resend setup"
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI enrichment — see README "LLM configuration". OpenAI is the default provider;
# Anthropic is implemented as a fully working swappable alternative.
AI_ENRICHMENT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Planning data provider — see README "Planning provider setup".
# Defaults to the mock provider so the app runs end-to-end with zero external
# credentials. Switch to "plota" only once PLOTA_API_KEY is set.
PLANNING_PROVIDER=mock
PLOTA_API_KEY=
# Keep scheduled Plota reads bounded while using the Demo key (1 = one ten-row page/run).
PLOTA_MAX_PAGES_PER_RUN=1
PLOTA_WEBHOOK_SECRET=

# Verifies pg_cron -> Supabase Edge Function calls (see README "Cron jobs")
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo-only territory activation — exact user email(s) or auth UUID(s), comma/newline separated.
# Leave empty in production except for explicitly allow-listed internal demo accounts.
MYTRADEBOX_DEMO_USER_EMAILS=
MYTRADEBOX_DEMO_USER_IDS=
