# Supabase — see README "Supabase setup"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — these are Cloudflare Worker variables, not Supabase Edge Function secrets.
# Never expose the secret key or webhook secret to the browser. Checkout is a
# server-side redirect to a hosted monthly Checkout Session (no Stripe.js/Elements),
# so NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY isn't read by current code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — see README "Resend setup"
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MyTradeBox
RESEND_REPLY_TO=

# AI enrichment — see README "LLM configuration". OpenAI is the default provider;
# Anthropic is implemented as a fully working swappable alternative.
AI_ENRICHMENT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ask MyTradeBox runs in the Next.js/Cloudflare app. It uses OpenAI for grounded
# answer generation and (when available) semantic embeddings. Knowledge retrieval
# automatically falls back to PostgreSQL full-text search if embeddings fail.
ASK_MYTRADEBOX_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Planning data provider — see README "Planning provider setup".
# Defaults to the mock provider so the app runs end-to-end with zero external
# credentials. Switch to "plota" only once PLOTA_API_KEY is set.
PLANNING_PROVIDER=mock
PLOTA_API_KEY=
# Keep scheduled Plota reads bounded while using the Demo key (1 = one ten-row page/run).
PLOTA_MAX_PAGES_PER_RUN=1

# Verifies pg_cron -> Supabase Edge Function calls (see README "Cron jobs")
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public legal/contact configuration — set these before production launch.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=MyTradeBox
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=

# Demo-only territory activation — exact user email(s) or auth UUID(s), comma/newline separated.
# Leave empty in production except for explicitly allow-listed internal demo accounts.
MYTRADEBOX_DEMO_USER_EMAILS=
MYTRADEBOX_DEMO_USER_IDS=
