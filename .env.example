# Product brand.
NEXT_PUBLIC_PRODUCT_NAME=MyTradeBox
NEXT_PUBLIC_PRODUCT_SHORT_NAME=MyTradeBox
NEXT_PUBLIC_PRODUCT_ICON_LIGHT=/brand/mytradebox-icon-light.png
NEXT_PUBLIC_PRODUCT_ICON_DARK=/brand/mytradebox-icon.png

# Supabase — see README "Supabase setup"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Cloudflare Worker variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — transactional/platform email. Keep sender unset until the domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MyTradeBox
RESEND_REPLY_TO=

# AI enrichment + retrieval.
AI_ENRICHMENT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASK_MYTRADEBOX_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Provider adapter selection. Adapters fail closed when their credentials are absent.
PROVIDER_ADAPTERS=plota,find-a-tender,contracts-finder

# Planning data.
PLANNING_PROVIDER=mock
PLOTA_API_KEY=
PLOTA_MAX_PAGES_PER_RUN=1

# Public/core providers to configure progressively.
COMPANIES_HOUSE_API_KEY=
FSA_API_BASE_URL=
CQC_API_BASE_URL=
NHS_ODS_API_BASE_URL=
EPC_API_BEARER_TOKEN=
IDEAL_POSTCODES_API_KEY=

# Paid enrichment providers — enable only after licence and retention review.
PEOPLE_DATA_LABS_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
COGNISM_API_KEY=
GOOGLE_PLACES_API_KEY=
WAPPALYZER_API_KEY=
ADZUNA_API_KEY=
CORESIGNAL_API_KEY=
DATAGARDENER_API_KEY=
FULLCIRCL_API_KEY=
CREDITSAFE_API_KEY=
BEAUHURST_API_KEY=
DEALROOM_API_KEY=
NIMBUS_API_KEY=

# Published planning-contact enrichment. Enable only on a licensed provider plan.
CONTACT_INTELLIGENCE_PROVIDER=none

# Property / recency intelligence.
PROPERTY_INTELLIGENCE_PROVIDER=none
TWENTYCI_CLIENT_ID=
TWENTYCI_CLIENT_SECRET=
TWENTYCI_USERNAME=
TWENTYCI_PASSWORD=

# Physical postal outreach.
POSTAL_OUTREACH_PROVIDER=none
STANNP_API_KEY=
QUOTE_LINK_SIGNING_SECRET=

# Public/commercial market-signal sources — Supabase Edge Function environment only.
MARKET_SIGNAL_PROVIDERS=find-a-tender,contracts-finder

# Verifies pg_cron -> Supabase Edge Function calls.
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public legal/contact configuration.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=MyTradeBox
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=

# Demo-only activation. Keep legacy MYTRADEBOX_* aliases until the clone is fully rebranded.
DEMO_USER_EMAILS=
DEMO_USER_IDS=
MYTRADEBOX_DEMO_USER_EMAILS=
MYTRADEBOX_DEMO_USER_IDS=
