# Product brand.
NEXT_PUBLIC_PRODUCT_NAME=TradeSignal
NEXT_PUBLIC_PRODUCT_SHORT_NAME=TradeSignal
NEXT_PUBLIC_PRODUCT_ICON_LIGHT=/brand/mytradebox-icon-light.png
NEXT_PUBLIC_PRODUCT_ICON_DARK=/brand/mytradebox-icon.png

# Supabase — see README "Supabase setup"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Cloudflare Worker variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — transactional/platform email. Keep sender unset until the domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=TradeSignal
RESEND_REPLY_TO=

# AI enrichment + retrieval.
AI_ENRICHMENT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-5-mini
PROFILE_NORMALISER_MODEL=gpt-5-mini
ASK_TRADESIGNAL_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Provider adapter selection. Adapters fail closed when credentials are absent.
# Use provider_config.provider_key values here; keep provider keys lowercase with hyphens.
PROVIDER_ADAPTERS=plota,companies-house,find-a-tender,contracts-finder

# Planning and commercial property signals.
PLANNING_PROVIDER=mock
PLOTA_API_KEY=
PLOTA_MAX_PAGES_PER_RUN=1
PLANNING_DATA_API_KEY=
PLANNING_DATA_BASE_URL=
EPC_API_BEARER_TOKEN=
EPC_API_BASE_URL=
EPC_NON_DOMESTIC_API_BEARER_TOKEN=
EPC_NON_DOMESTIC_API_BASE_URL=
HMLR_CORPORATE_API_KEY=
HMLR_CORPORATE_API_BASE_URL=
HMLR_LEASES_API_KEY=
HMLR_LEASES_API_BASE_URL=
NIMBUS_API_KEY=
NIMBUS_API_BASE_URL=

# Business identity and regulated-establishment sources.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_API_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_STREAMS_API_BASE_URL=
COMPANIES_HOUSE_BULK_API_BASE_URL=
FSA_API_KEY=
FSA_API_BASE_URL=
CQC_API_KEY=
CQC_API_BASE_URL=
NHS_ODS_API_KEY=
NHS_ODS_API_BASE_URL=
IDEAL_POSTCODES_API_KEY=
IDEAL_POSTCODES_API_BASE_URL=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_BASE_URL=

# Procurement sources. Find a Tender and Contracts Finder are public feeds;
# their base URLs are configurable even when no secret is required.
FIND_A_TENDER_API_KEY=
FIND_A_TENDER_API_BASE_URL=https://www.find-tender.service.gov.uk/
CONTRACTS_FINDER_API_KEY=
CONTRACTS_FINDER_API_BASE_URL=https://www.contractsfinder.service.gov.uk/

# Business growth and hiring signals.
ADZUNA_APP_ID=
ADZUNA_API_KEY=
ADZUNA_API_BASE_URL=
CORESIGNAL_API_KEY=
CORESIGNAL_API_BASE_URL=
BEAUHURST_API_KEY=
BEAUHURST_API_BASE_URL=
DEALROOM_API_KEY=
DEALROOM_API_BASE_URL=
DATAGARDENER_API_KEY=
DATAGARDENER_API_BASE_URL=
FULLCIRCL_API_KEY=
FULLCIRCL_API_BASE_URL=
CREDITSAFE_API_KEY=
CREDITSAFE_API_BASE_URL=
WAPPALYZER_API_KEY=
WAPPALYZER_API_BASE_URL=

# Professional company and contact enrichment. These must remain server-side
# and should only be called after a qualified signal or paid lead unlock.
PEOPLE_DATA_LABS_API_KEY=
PEOPLE_DATA_LABS_API_BASE_URL=
PDL_API_KEY=
PDL_API_BASE_URL=
HUNTER_API_KEY=
HUNTER_API_BASE_URL=
APOLLO_API_KEY=
APOLLO_API_BASE_URL=
COGNISM_API_KEY=
COGNISM_API_BASE_URL=

# Public/commercial market-signal sources — Supabase Edge Function environment only.
 — Supabase Edge Function environment only.
MARKET_SIGNAL_PROVIDERS=find-a-tender,contracts-finder

# Verifies pg_cron -> Supabase Edge Function calls.
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public legal/contact configuration.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=TradeSignal
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=

# Demo-only activation.
DEMO_USER_EMAILS=
DEMO_USER_IDS=
